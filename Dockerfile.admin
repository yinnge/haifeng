# ============================================================
# haifeng-admin 构建镜像（服务器 2核4G，限制构建内存防 OOM）
# ============================================================

# ---------- 构建阶段 ----------
FROM maven:3.9-eclipse-temurin-17 AS builder
WORKDIR /build

# 先拷贝所有 pom 触发依赖下载缓存层
COPY pom.xml ./
COPY haifeng-common/pom.xml haifeng-common/pom.xml
COPY haifeng-admin/pom.xml haifeng-admin/pom.xml
COPY haifeng-app/pom.xml haifeng-app/pom.xml
COPY haifeng-common/src haifeng-common/src
COPY haifeng-admin/src haifeng-admin/src

# 限制 Maven/JVM 内存，防止 2G 服务器 OOM
ENV MAVEN_OPTS="-Xmx768m -XX:MaxMetaspaceSize=384m" \
    JAVA_TOOL_OPTIONS="-Xmx768m"

RUN --mount=type=cache,target=/root/.m2/repository \
    mvn -B clean package -pl haifeng-admin -am -Dmaven.test.skip=true -q

# ---------- 运行阶段 ----------
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app

# TZ 时区
RUN apk add --no-cache tzdata && cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime

# 运行时 JVM 内存限制，服务器 4G 下两台后端共约 1.5G
ENV JAVA_OPTS="-Xms128m -Xmx320m -XX:MaxMetaspaceSize=128m -XX:+UseG1GC -Djava.security.egd=file:/dev/./urandom"

COPY --from=builder /build/haifeng-admin/target/haifeng-admin-*.jar app.jar

EXPOSE 18081
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /app/app.jar"]