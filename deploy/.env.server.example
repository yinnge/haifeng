# PostgreSQL
DB_HOST=postgresql
DB_PORT=5432
DB_NAME=haifeng
DB_USERNAME=haifeng
DB_PASSWORD=<strong-password>

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<strong-password>
REDIS_DATABASE=0

# JWT（生产环境必须修改，至少32字符）
JWT_ACCESS_SECRET=<renew-32+chars>
JWT_REFRESH_SECRET=<renew-32+chars>
JWT_ACCESS_EXPIRE=7200
JWT_REFRESH_EXPIRE=604800

# Spring
SPRING_PROFILES_ACTIVE=prod

# 服务端口（容器内固定，.env 中可省略，此处仅为参考）
# ADMIN_PORT=18081
# APP_PORT=18080

# Spring AI
DEEPSEEK_API_KEYS=<your-deepseek-keys>

# 安全密钥（生产环境必须修改）
AES_SECRET_KEY=<receive-16+chars>
HASH_SALT=<receive-16+chars>

# 阿里云OSS配置
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_REGION=cn-beijing
OSS_ACCESS_KEY_ID=<your-access-key-id>
OSS_ACCESS_KEY_SECRET=<your-access-key-secret>
OSS_BUCKET_NAME=haifeng1
OSS_URL_EXPIRE=3600
# 公开素材 bucket（公共读）：仅存头像/轮播图/二维码等公开图片。
# 需在阿里云单独创建公共读 bucket；严禁把 OSS_BUCKET_NAME 改为公共读。
OSS_PUBLIC_BUCKET_NAME=haifeng-public
OSS_PUBLIC_URL_PREFIX=https://haifeng-public.oss-cn-beijing.aliyuncs.com
# 会员头像专用 bucket（用户自制头像，固定 key 覆盖式更新，需公共读）
OSS_AVATAR_BUCKET_NAME=haifeng-memeber-svg
OSS_AVATAR_URL_PREFIX=https://haifeng-memeber-svg.oss-cn-beijing.aliyuncs.com
# 院校 Logo 专用 bucket（公共读）：服务器按实际地域填写 URL 前缀，留空则由 bucket+endpoint 推导
OSS_UNIVERSITY_LOGO_BUCKET_NAME=universities-logo
OSS_UNIVERSITY_LOGO_URL_PREFIX=https://universities-logo.oss-cn-beijing.aliyuncs.com
# 院校详情轮播图专用 bucket（公共读）
# 注意：阿里云上实际创建的 bucket 名为 univeristies-detail（i/e 顺序与 universities 不同）
OSS_UNIVERSITY_DETAIL_BUCKET_NAME=univeristies-detail
OSS_UNIVERSITY_DETAIL_URL_PREFIX=https://univeristies-detail.oss-cn-beijing.aliyuncs.com
# 校园图册图片专用 bucket（公共读）：服务器按实际地域填写 URL 前缀，留空则由 bucket+endpoint 推导
OSS_UNIVERSITY_ALBUM_BUCKET_NAME=universities-album
OSS_UNIVERSITY_ALBUM_URL_PREFIX=https://universities-album.oss-cn-beijing.aliyuncs.com
# 城市封面图专用 bucket（公共读）
OSS_CITY_COVER_BUCKET_NAME=city-cover-image
OSS_CITY_COVER_URL_PREFIX=https://city-cover-image.oss-cn-beijing.aliyuncs.com

# KKFileView预览服务（容器内地址）
KKFILEVIEW_BASE_URL=http://kkfileview:8012