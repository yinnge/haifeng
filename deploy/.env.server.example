# PostgreSQL
DB_HOST=postgresql
DB_PORT=5432
DB_NAME=haifeng
DB_USERNAME=haifeng
DB_PASSWORD=<strong-password>

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<strong-password>
REDIS_DATABASE=0

# JWT（生产环境必须修改，至少32字符）
JWT_ACCESS_SECRET=<renew-32+chars>
JWT_REFRESH_SECRET=<renew-32+chars>
JWT_ACCESS_EXPIRE=7200
JWT_REFRESH_EXPIRE=604800

# Spring
SPRING_PROFILES_ACTIVE=prod

# 服务端口（容器内固定，.env 中可省略，此处仅为参考）
# ADMIN_PORT=18081
# APP_PORT=18080

# Spring AI
DEEPSEEK_API_KEYS=<your-deepseek-keys>

# 安全密钥（生产环境必须修改）
AES_SECRET_KEY=<receive-16+chars>
HASH_SALT=<receive-16+chars>